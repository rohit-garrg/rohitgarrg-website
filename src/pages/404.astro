---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingCard from '../components/WritingCard.astro';

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Page Not Found - Rohit Garg"
  description="The page you're looking for doesn't exist."
>
  <div class="error-page">
    <div class="error-hero">
      <h1 class="error-code">404</h1>
      <p class="error-message">That page doesn't exist, or it moved.</p>
      <div class="error-actions">
        <a href="/writing" class="btn-primary">Back to writing</a>
        <a href="/" class="btn-ghost">Home</a>
      </div>
    </div>

    <section class="suggestions" aria-label="Recent posts">
      <p class="suggestions-eyebrow mono-xxs">While you're here</p>
      <div class="suggestions-grid">
        {recentPosts.map(post => (
          <WritingCard
            title={post.data.title}
            excerpt={post.data.excerpt}
            date={post.data.date}
            readingTime={post.data.readMin}
            cover={post.data.cover}
            tag={post.data.tag}
            slug={post.id.replace(/\.md$/, '')}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .error-page {
    padding: 0 0 80px;
  }

  .error-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 80px 24px 60px;
    min-height: 40vh;
    justify-content: center;
  }

  .error-code {
    font-family: var(--font-serif);
    font-size: 72px;
    font-weight: 400;
    color: var(--color-ink-2);
    line-height: 1;
    margin-bottom: 16px;
  }

  .error-message {
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--color-ink-2);
    margin-bottom: 32px;
  }

  .error-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: opacity 200ms ease;
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }

  .btn-primary:hover,
  .btn-ghost:hover {
    opacity: 0.85;
  }

  .btn-primary:hover {
    color: var(--color-paper);
  }

  .btn-primary:focus-visible,
  .btn-ghost:focus-visible {
    outline: 2px solid var(--color-peri-ink);
    outline-offset: 2px;
  }

  /* Recent post suggestions */
  .suggestions {
    max-width: 1120px;
    margin: 0 auto;
    padding: 40px;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
  }

  .suggestions-eyebrow {
    color: var(--color-mute);
    margin-bottom: 24px;
  }

  .suggestions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 1023px) {
    .suggestions {
      margin: 0 48px;
    }

    .suggestions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .error-hero {
      padding: 56px 24px 40px;
    }

    .error-code {
      font-size: 56px;
    }

    .error-message {
      font-size: 16px;
    }

    .suggestions {
      margin: 0 24px;
      padding: 28px 20px;
    }

    .suggestions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
