---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBlock from '../components/HeroBlock.astro';
import WritingCard from '../components/WritingCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

// Writing: 3 most recent
const allWriting = await getCollection('posts');
const latestWriting = allWriting
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function getReadingTime(article: typeof latestWriting[0]): number {
  return article.data.readMin;
}

// Projects: ordered by `order` field
const allProjects = await getCollection('projects');
const orderedProjects = allProjects
  .filter((p) => p.data.order !== undefined)
  .sort((a, b) => a.data.order! - b.data.order!)
  .slice(0, 3);

// WebSite schema for homepage
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Rohit Garg",
  "description": "Head of Product & Design at Times of India. Writing about product management, leadership, and AI tools.",
  "url": "https://www.rohitgarrg.com",
  "author": {
    "@type": "Person",
    "name": "Rohit Garg",
    "jobTitle": "Head of Product & Design",
    "worksFor": {
      "@type": "Organization",
      "name": "Times of India"
    }
  }
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <HeroBlock />

  <section class="section-writing" aria-label="Recent writing">
    <div class="container-wide">
      <div class="section-header">
        <div class="section-header-text">
          <p class="section-eyebrow mono-xxs">
            <span class="pebble pebble-peri" aria-hidden="true"></span>
            Writing
          </p>
          <h2 class="type-h2">Essays on product, AI, leadership, and the occasional book review.</h2>
        </div>
        <a href="/writing" class="section-cta">See all writing &rarr;</a>
      </div>

      <div class="writing-grid">
        {latestWriting.map((article, i) => (
          <WritingCard
            title={article.data.title}
            excerpt={article.data.excerpt}
            date={article.data.date}
            readingTime={getReadingTime(article)}
            cover={article.data.cover}
            tag={article.data.tag}
            slug={article.id.replace(/\.md$/, '')}
            featured={i === 0}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section-projects" aria-label="Projects">
    <div class="container-wide">
      <div class="section-header">
        <div class="section-header-text">
          <p class="section-eyebrow mono-xxs">
            <span class="pebble pebble-sage" aria-hidden="true"></span>
            Projects
          </p>
          <h2 class="type-h2">Side projects, experiments, and things I'm tinkering with.</h2>
        </div>
        <a href="/projects" class="section-cta">All projects &rarr;</a>
      </div>

      <div class="projects-grid">
        {orderedProjects.map((project) => (
          <ProjectCard
            name={project.data.name ?? project.data.title}
            blurb={project.data.blurb ?? project.data.description}
            stack={project.data.stack ?? []}
            image={project.data.image}
            url={project.data.url}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section-newsletter" id="newsletter" aria-label="Newsletter signup">
    <div class="newsletter-card">
      <div class="nl-blob nl-blob-peri" aria-hidden="true"></div>
      <div class="nl-blob nl-blob-sage" aria-hidden="true"></div>

      <div class="newsletter-content">
        <p class="nl-eyebrow mono-xs">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          The newsletter
        </p>

        <h2 class="display-md">A short note in your inbox most <em class="nl-italic">Sundays</em>.</h2>

        <p class="nl-body body-md">
          One essay, roughly weekly. Product, AI, leadership, and the occasional book I could not shut up about. No ads, no course funnels, no five-part email sequences. Unsubscribe with one click.
        </p>

        <NewsletterForm />

        <p class="nl-proof caption">Free forever. One click to unsubscribe.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Shared section styles ── */
  .section-writing,
  .section-projects {
    padding: var(--spacing-section-y) 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 36px;
  }

  .section-header-text {
    max-width: 620px;
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-mute);
    margin-bottom: 10px;
  }

  .pebble {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-organic-bead);
    flex-shrink: 0;
  }

  .pebble-peri { background: var(--color-peri); }
  .pebble-sage { background: var(--color-sage); }

  .section-header h2 {
    margin-bottom: 0;
  }

  .section-cta {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: border-color 200ms ease;
  }

  .section-cta:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .section-cta:focus-visible {
    outline: 2px solid var(--color-peri-ink);
    outline-offset: 2px;
  }

  /* ── Writing grid ── */
  .writing-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 24px;
  }

  /* ── Projects grid ── */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
  }

  /* ── Newsletter CTA ── */
  .section-newsletter {
    padding: 30px var(--spacing-page-x-desktop) 100px;
  }

  .newsletter-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(145deg, var(--color-peri-pale) 0%, var(--color-sage-pale) 120%);
    border: 1px solid oklch(0.90 0.04 260);
    border-radius: var(--radius-organic-a);
    padding: 70px;
  }

  .nl-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .nl-blob-peri {
    width: 200px;
    height: 200px;
    background: var(--color-peri-pale);
    opacity: 0.6;
    top: -40px;
    right: -40px;
  }

  .nl-blob-sage {
    width: 160px;
    height: 160px;
    background: var(--color-sage-pale);
    opacity: 0.5;
    bottom: -30px;
    left: -30px;
  }

  .newsletter-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nl-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-peri-ink);
    margin-bottom: 18px;
  }

  .newsletter-content h2 {
    margin-bottom: 18px;
    color: var(--color-ink);
  }

  .nl-italic {
    font-style: italic;
    color: var(--color-peri-ink);
  }

  .nl-body {
    color: var(--color-ink-2);
    max-width: 560px;
    margin-bottom: 28px;
  }

  .nl-proof {
    color: var(--color-mute);
    margin-top: 14px;
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .writing-grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Hide third card on tablet */
    .writing-grid > :global(:nth-child(3)) {
      display: none;
    }

    .projects-grid {
      grid-template-columns: 1fr 1fr;
    }

    .projects-grid > :global(:nth-child(3)) {
      display: none;
    }

    .section-newsletter {
      padding-left: var(--spacing-page-x-tablet);
      padding-right: var(--spacing-page-x-tablet);
    }

    .newsletter-card {
      padding: 50px 40px;
    }
  }

  @media (max-width: 767px) {
    .section-writing,
    .section-projects {
      padding: var(--spacing-section-y-mobile) 0;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .writing-grid {
      grid-template-columns: 1fr;
    }

    /* Show all cards on mobile (single column) */
    .writing-grid > :global(:nth-child(3)) {
      display: flex;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .projects-grid > :global(:nth-child(3)) {
      display: flex;
    }

    .section-newsletter {
      padding: 20px var(--spacing-page-x-mobile) 60px;
    }

    .newsletter-card {
      padding: 40px 24px;
      border-radius: 28px 32px 28px 36px / 32px 28px 36px 28px;
    }

    .newsletter-content h2 {
      font-size: 32px;
    }
  }
</style>
