---
import BaseLayout from '../layouts/BaseLayout.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Rohit Garg",
  "url": "https://www.rohitgarrg.com",
  "image": "https://www.rohitgarrg.com/images/headshot.webp",
  "jobTitle": "Head of Product & Design",
  "worksFor": {
    "@type": "Organization",
    "name": "Times of India",
    "url": "https://timesofindia.indiatimes.com"
  },
  "description": "Product leader with 14+ years of experience across media, travel, and real estate. Leading a 60+ person team building digital products at scale.",
  "knowsAbout": ["Product Management", "Design", "AI Tools", "Leadership"],
  "sameAs": [
    "https://www.linkedin.com/in/rohitgarrg/"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.rohitgarrg.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About",
      "item": "https://www.rohitgarrg.com/about"
    }
  ]
};
---

<BaseLayout
  title="About - Rohit Garg"
  description="Head of Product & Design at Times of India. Building products at scale, writing about leadership and AI tools."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="about-page container-page">

    <header class="about-header">
      <div class="header-portrait">
        <img
          src="/images/headshot.webp"
          alt="Rohit Garg"
          width="220"
          height="220"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="header-text">
        <h1 class="display-lg">About</h1>
        <p class="header-role">Head of Product & Design at Times of India</p>
      </div>
    </header>

    <section class="about-body">
      <p class="lead">
        I lead Product and Design at Times of India, India's largest digital news publisher. My team of 60+ handles everything from the core reading experience to the ad platform to the puzzle games you might be playing during your commute.
      </p>

      <p>
        The work I find most interesting sits at the intersection of three things: building products that genuinely help users, making the math work for the business, and doing it with a team that's growing and learning along the way. I've been doing this for 14+ years across media, travel, and real estate — but the constants have stayed the same. Understand the user. Ship things. Measure what matters. Iterate.
      </p>

      <p>
        These days, I'm especially interested in how AI is reshaping product development. Not the hype, but the practical stuff: how it changes what's possible to build, how fast you can move, what new capabilities become table stakes. This site is partly an excuse to keep experimenting.
      </p>

      <p>
        Outside work, I'm based in Delhi-NCR, usually stuck in traffic between Gurgaon and Noida. I have twin toddlers, which means my reading happens via audiobooks during that commute. (<a href="/writing/audiobook-commute-reading-habit" class="hl">38 books in the last three years</a> — I wrote about it.) When I'm not doing any of that, I'm probably tinkering with some side project that may or may not go anywhere.
      </p>
    </section>

    <section class="mentoring-block">
      <h2>Mentoring</h2>
      <p>
        I'm open to mentoring folks earlier in their product careers — especially those figuring out the craft, not just the job hunt. If you're working through a real problem and want a sounding board, feel free to reach out. I can't help with referrals or hiring at my current organization, but I'm happy to talk shop.
      </p>
    </section>

    <section class="contact-block">
      <h2>Get in touch</h2>
      <p class="contact-intro">I'm always happy to connect with fellow product people, discuss ideas, or explore collaboration opportunities.</p>
      <div class="contact-actions">
        <a href="https://www.linkedin.com/in/rohitgarrg/" target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <a href="mailto:rohitgarrg@gmail.com" class="btn-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          Email
        </a>
      </div>
    </section>

  </article>
</BaseLayout>

<style>
  .about-page {
    padding-top: var(--spacing-section-y);
    padding-bottom: var(--spacing-section-y);
  }

  /* ── Header ── */
  .about-header {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 36px;
    align-items: center;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 48px;
  }

  .header-portrait img {
    width: 220px;
    height: 220px;
    object-fit: cover;
    object-position: 50% 15%;
    border-radius: 44% 56% 50% 50% / 50% 45% 55% 50%;
    box-shadow: var(--shadow-portrait);
  }

  .header-text h1 {
    margin-bottom: 8px;
  }

  .header-role {
    font-size: 18px;
    color: var(--color-ink-2);
    margin-bottom: 0;
  }

  /* ── Body ── */
  .about-body {
    max-width: 68ch;
    margin-bottom: 56px;
  }

  .about-body p {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.62;
    color: var(--color-ink);
    margin-bottom: 20px;
  }

  .about-body .lead {
    color: var(--color-ink-2);
  }

  .about-body a {
    color: var(--color-peri-ink);
    text-decoration: none;
  }

  .about-body a:hover {
    color: var(--color-peri);
  }

  .about-body .hl {
    color: var(--color-peri-ink);
  }

  /* ── Mentoring ── */
  .mentoring-block {
    background: var(--color-sage-pale);
    border: 1px solid oklch(0.88 0.04 160);
    border-radius: var(--radius-xl);
    padding: 28px 32px;
    margin-bottom: 48px;
  }

  .mentoring-block h2,
  .contact-block h2 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .mentoring-block p {
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--color-ink-2);
    margin-bottom: 0;
  }

  /* ── Contact ── */
  .contact-block {
    padding-top: 40px;
    border-top: 1px solid var(--color-line);
  }

  .contact-intro {
    color: var(--color-ink-2);
    margin-bottom: 20px;
  }

  .contact-actions {
    display: flex;
    gap: 12px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-paper);
    text-decoration: none;
    transition: opacity 200ms ease;
  }

  .btn-primary:hover {
    opacity: 0.85;
    color: var(--color-paper);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--color-peri-ink);
    outline-offset: 2px;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 200ms ease;
  }

  .btn-ghost:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .btn-ghost:focus-visible {
    outline: 2px solid var(--color-peri-ink);
    outline-offset: 2px;
  }

  /* ── Responsive ── */
  @media (max-width: 767px) {
    .about-page {
      padding-top: var(--spacing-section-y-mobile);
      padding-bottom: var(--spacing-section-y-mobile);
    }

    .about-header {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
      gap: 24px;
      margin-bottom: 36px;
    }

    .header-portrait img {
      width: 100%;
      max-width: 280px;
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .about-body p {
      font-size: 17px;
    }

    .mentoring-block {
      padding: 24px;
    }

    .contact-actions {
      flex-direction: column;
    }

    .btn-primary,
    .btn-ghost {
      justify-content: center;
    }
  }
</style>
