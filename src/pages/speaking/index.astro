---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeakingEntry from '../../components/SpeakingEntry.astro';

const allSpeaking = await getCollection('speaking');

const sorted = allSpeaking
  .map((entry) => ({
    slug: entry.id.replace(/\.mdx?$/, ''),
    event: entry.data.event,
    title: entry.data.title,
    date: entry.data.date,
    description: entry.data.description,
    url: entry.data.url,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

// Group by year, descending
const groupedByYear = sorted.reduce((acc, entry) => {
  const year = entry.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(entry);
  return acc;
}, {} as Record<string, typeof sorted>);

const years = Object.keys(groupedByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Speaking - Rohit Garg"
  description="Talks and presentations at industry events and institutions. Usually about product, AI at scale, or news distribution."
>
  <div class="speaking-page container-page">
    <header class="speaking-header">
      <h1 class="display-lg"><em>Speaking</em></h1>
      <p class="speaking-sub body-md">Talks and presentations at industry events and institutions. Usually about product, AI at scale, or news distribution.</p>
    </header>

    {years.length > 0 ? (
      years.map((year) => (
        <section class="year-group" aria-label={`${year} events`}>
          <h2 class="year-label">{year}</h2>
          <div class="timeline">
            {groupedByYear[year].map((entry) => (
              <SpeakingEntry
                slug={entry.slug}
                event={entry.event}
                title={entry.title}
                date={entry.date}
                description={entry.description}
                url={entry.url}
              />
            ))}
          </div>
        </section>
      ))
    ) : (
      <p class="empty-state">Speaking engagements coming soon.</p>
    )}
  </div>
</BaseLayout>

<style>
  .speaking-page {
    padding-top: var(--spacing-section-y);
    padding-bottom: var(--spacing-section-y);
  }

  .speaking-header {
    margin-bottom: 56px;
  }

  .speaking-header h1 {
    margin-bottom: 12px;
  }

  .speaking-sub {
    color: var(--color-ink-2);
    max-width: 56ch;
  }

  .year-group {
    margin-bottom: 48px;
  }

  .year-group:last-child {
    margin-bottom: 0;
  }

  .year-label {
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 24px;
  }

  .empty-state {
    padding: 40px 0;
    text-align: center;
    color: var(--color-mute);
  }

  @media (max-width: 767px) {
    .speaking-page {
      padding-top: var(--spacing-section-y-mobile);
      padding-bottom: var(--spacing-section-y-mobile);
    }

    .speaking-header {
      margin-bottom: 40px;
    }

    .year-label {
      font-size: 28px;
    }

    .year-group {
      margin-bottom: 36px;
    }
  }
</style>
