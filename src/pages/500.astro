---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Server Error - Rohit Garg"
  description="Something went wrong."
>
  <div class="error-hero">
    <h1 class="error-code">500</h1>
    <p class="error-message">Something broke on our end.</p>
    <div class="error-actions">
      <a href="/writing" class="btn-primary">Back to writing</a>
      <a href="/" class="btn-ghost">Home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .error-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 80px 24px;
    min-height: 60vh;
    justify-content: center;
  }

  .error-code {
    font-family: var(--font-serif);
    font-size: 72px;
    font-weight: 400;
    color: var(--color-ink-2);
    line-height: 1;
    margin-bottom: 16px;
  }

  .error-message {
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--color-ink-2);
    margin-bottom: 32px;
  }

  .error-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: opacity 200ms ease;
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }

  .btn-primary:hover,
  .btn-ghost:hover {
    opacity: 0.85;
  }

  .btn-primary:hover {
    color: var(--color-paper);
  }

  .btn-primary:focus-visible,
  .btn-ghost:focus-visible {
    outline: 2px solid var(--color-peri-ink);
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    .error-hero {
      padding: 56px 24px;
    }

    .error-code {
      font-size: 56px;
    }

    .error-message {
      font-size: 16px;
    }
  }
</style>
