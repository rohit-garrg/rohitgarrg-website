---
interface Props {
  slug: string;
  event: string;
  title: string;
  date: Date;
  description: string;
  url?: string;
}

const { slug, event, title, date, description, url } = Astro.props;

const month = date.toLocaleDateString('en-US', { month: 'long' });
const dateStr = date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
const detailUrl = `/speaking/${slug}/`;
---

<div class="entry">
  <div class="entry-marker">
    <span class="pebble" aria-hidden="true"></span>
  </div>
  <div class="entry-content">
    <p class="entry-when mono-xs">{month} · {dateStr}</p>
    <h3 class="entry-venue">{event}</h3>
    <p class="entry-title">{title}</p>
    <p class="entry-blurb">{description}</p>
    <a href={detailUrl} class="entry-link">View details →</a>
  </div>
</div>

<style>
  .entry {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 0;
    padding-bottom: 36px;
    position: relative;
  }

  .entry-marker {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Vertical line */
  .entry-marker::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    background: var(--color-line);
  }

  .pebble {
    position: relative;
    top: 0.35em;
    width: 10px;
    height: 10px;
    background: var(--color-peri);
    border-radius: var(--radius-organic-bead);
    z-index: 1;
  }

  .entry-content {
    padding-left: 16px;
  }

  .entry-when {
    color: var(--color-mute);
    margin-bottom: 6px;
  }

  .entry-venue {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.012em;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .entry-title {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-peri-ink);
    margin-bottom: 6px;
  }

  .entry-blurb {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 64ch;
    margin-bottom: 8px;
  }

  .entry-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-peri-ink);
    text-decoration: none;
  }

  .entry-link:hover {
    color: var(--color-peri);
  }

  /* Last entry in a group: hide the trailing line */
  .entry:last-child .entry-marker::before {
    bottom: 50%;
  }

  @media (max-width: 767px) {
    .entry-venue {
      font-size: 22px;
    }

    .entry-content {
      padding-left: 12px;
    }
  }
</style>
