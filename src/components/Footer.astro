---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-signature">
      <p>Product and design at scale. Tinkering with AI. Notes from a product leader in Delhi-NCR.</p>
    </div>

    <div class="footer-col">
      <h4 class="mono-xxs">Blogs</h4>
      <ul>
        <li><a href="/writing">All posts</a></li>
        <li><a href="/writing">AI</a></li>
        <li><a href="/writing">Leadership</a></li>
        <li><a href="/writing">Books</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="mono-xxs">Projects</h4>
      <ul>
        <li><a href="/planetia">Planetia</a></li>
        <li><a href="/projects/office-survivors">Office Survivors</a></li>
        <li><a href="/projects/solar-system">Solar System Explorer</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="mono-xxs">Elsewhere</h4>
      <ul>
        <li><a href="https://www.linkedin.com/in/rohitgarrg/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href="https://twitter.com/rohitgarrg" target="_blank" rel="noopener noreferrer">Twitter / X</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="mailto:rohitgarrg@gmail.com">rohitgarrg@gmail.com</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-meta">
    <span>&copy; {currentYear} Rohit Garg &middot; Delhi-NCR</span>
    <span>Built with Astro on Vercel</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px var(--spacing-page-x-desktop) 40px;
  }

  .footer-signature p {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.3;
    color: var(--color-ink);
    max-width: 34ch;
    margin: 0;
  }

  .footer-col h4 {
    color: var(--color-mute);
    margin-bottom: 16px;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a {
    color: var(--color-ink-2);
    font-family: var(--font-sans);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--color-peri-ink);
  }

  .footer-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px var(--spacing-page-x-desktop);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-mute);
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1023px) {
    .footer-grid {
      padding: 40px var(--spacing-page-x-tablet) 32px;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .footer-signature {
      grid-column: 1 / -1;
    }

    .footer-meta {
      padding: 20px var(--spacing-page-x-tablet);
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 32px var(--spacing-page-x-mobile) 24px;
    }

    .footer-meta {
      flex-direction: column;
      gap: 8px;
      text-align: center;
      padding: 20px var(--spacing-page-x-mobile);
    }
  }
</style>
