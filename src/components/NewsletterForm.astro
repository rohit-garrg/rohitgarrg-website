---
/**
 * Pill-shaped newsletter signup form with six states.
 * Posts to /api/subscribe (Buttondown proxy). No framework needed.
 */
---

<div class="newsletter-form-wrap" data-newsletter-state="idle">
  <!-- Idle: the form -->
  <form class="pill-form" data-newsletter-form data-api="/api/subscribe" novalidate>
    <div style="position:absolute;left:-5000px;" aria-hidden="true">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      type="email"
      id="newsletter-email"
      name="email"
      placeholder="you@work.com"
      required
      autocomplete="email"
    />
    <button type="submit">
      <span class="btn-label">Subscribe &rarr;</span>
      <span class="btn-loading" aria-hidden="true">
        <span class="spinner"></span>
        Subscribing&hellip;
      </span>
    </button>
  </form>

  <!-- Error / Invalid: inline messages below form -->
  <p class="form-error" data-newsletter-error hidden></p>

  <!-- Success state -->
  <div class="form-result result-success" data-newsletter-result="success" hidden>
    <p>Check your inbox. Buttondown sent a confirmation link.</p>
  </div>

  <!-- Already subscribed state -->
  <div class="form-result result-already" data-newsletter-result="already" hidden>
    <p>You're already on the list. Check your inbox for the latest.</p>
  </div>
</div>

<script>
  document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
    const wrap = form.closest('[data-newsletter-state]') as HTMLElement;
    if (!wrap) return;

    const errorEl = wrap.querySelector('[data-newsletter-error]') as HTMLElement;
    const successEl = wrap.querySelector('[data-newsletter-result="success"]') as HTMLElement;
    const alreadyEl = wrap.querySelector('[data-newsletter-result="already"]') as HTMLElement;
    const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;

    function setState(state: string, errorMsg?: string) {
      wrap.dataset.newsletterState = state;

      // Show/hide form
      (form as HTMLElement).hidden = (state === 'success' || state === 'already');

      // Error message
      if (errorEl) {
        errorEl.hidden = (state !== 'error' && state !== 'invalid');
        if (errorMsg) errorEl.textContent = errorMsg;
      }

      // Results
      if (successEl) successEl.hidden = (state !== 'success');
      if (alreadyEl) alreadyEl.hidden = (state !== 'already');

      // Input state
      if (emailInput) {
        emailInput.disabled = (state === 'loading');
      }
    }

    (form as HTMLFormElement).addEventListener('submit', async (e) => {
      e.preventDefault();

      const honeypot = form.querySelector('input[name="website"]') as HTMLInputElement;
      if (honeypot?.value) {
        setState('success');
        return;
      }

      const email = emailInput?.value?.trim();

      if (!email || !email.includes('@') || !email.includes('.')) {
        setState('invalid', "That doesn't look like a valid email.");
        return;
      }

      setState('loading');

      try {
        const api = (form as HTMLElement).dataset.api!;
        const res = await fetch(api, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        if (res.ok) {
          setState('success');
          return;
        }

        if (res.status === 409) {
          setState('already');
          return;
        }

        setState('error', 'Something went wrong. Try again in a moment.');
      } catch {
        setState('error', 'Something went wrong. Try again in a moment.');
      }
    });

    // Clicking on error resets to idle
    errorEl?.addEventListener('click', () => {
      setState('idle');
      emailInput?.focus();
    });
  });
</script>

<style>
  .newsletter-form-wrap {
    width: 100%;
    max-width: 520px;
  }

  /* Pill form */
  .pill-form {
    display: flex;
    align-items: center;
    background: var(--color-paper);
    border-radius: var(--radius-pill);
    padding: 6px;
    box-shadow: var(--shadow-cta);
    position: relative;
  }

  .pill-form input[type="email"] {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ink);
    padding: 10px 18px;
    outline: none;
    min-width: 0;
  }

  .pill-form input[type="email"]::placeholder {
    color: var(--color-mute);
  }

  .pill-form input[type="email"]:focus {
    outline: none;
  }

  .pill-form button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    background: var(--color-ink);
    color: var(--color-paper);
    border: none;
    border-radius: var(--radius-pill);
    padding: 10px 22px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 200ms ease;
    flex-shrink: 0;
  }

  .pill-form button:hover {
    opacity: 0.85;
  }

  .pill-form button:focus-visible {
    outline: 2px solid var(--color-peri-ink);
    outline-offset: 2px;
  }

  /* Button states */
  .btn-loading {
    display: none;
    align-items: center;
    gap: 8px;
  }

  [data-newsletter-state="loading"] .btn-label {
    display: none;
  }

  [data-newsletter-state="loading"] .btn-loading {
    display: inline-flex;
  }

  [data-newsletter-state="loading"] button {
    pointer-events: none;
  }

  /* Spinner */
  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-paper);
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Error / Invalid */
  .form-error {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-berry);
    margin-top: 10px;
    padding-left: 18px;
    cursor: pointer;
  }

  /* Success / Already subscribed */
  .form-result {
    background: var(--color-peri-pale);
    border-radius: var(--radius-md);
    padding: 18px 24px;
  }

  .form-result p {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ink-2);
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .pill-form {
      flex-direction: column;
      border-radius: var(--radius-xl);
      padding: 8px;
      gap: 6px;
    }

    .pill-form input[type="email"] {
      width: 100%;
      text-align: center;
      padding: 12px 16px;
    }

    .pill-form button {
      width: 100%;
      justify-content: center;
      padding: 12px 22px;
    }
  }
</style>
